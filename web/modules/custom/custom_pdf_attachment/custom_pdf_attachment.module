<?php

use Drupal\commerce_order\Entity\OrderInterface;
use Drupal\commerce_license\Entity\License;
use Drupal\Core\Url;

/**
 * Implements hook_mail_alter().
 */
function custom_pdf_attachment_mail_alter(&$message) {
  // Only alter the order receipt emails.
  if ($message['key'] === 'commerce_order_receipt') {

    /** @var OrderInterface $order */
    $order = $message['params']['order'];

    if ($order instanceof OrderInterface) {
      $attachments = [];
      $download_links = [];

      // Load all licenses originating from this order.
      $licenses = \Drupal::entityTypeManager()
        ->getStorage('commerce_license')
        ->loadByProperties(['originating_order' => $order->id()]);

      foreach ($licenses as $license) {
        if ($license instanceof License) {
          $variation = $license->getPurchasedEntity();

          // Get files attached to the product variation (field_license_file is just an example field).
          if ($variation->hasField('field_license_file') && !$variation->get('field_license_file')->isEmpty()) {
            foreach ($variation->get('field_license_file') as $file_item) {
              $file = $file_item->entity;
              if ($file) {
                // Attach the file to the email.
                $attachments[] = [
                  'filecontent' => file_get_contents(\Drupal::service('file_system')->realpath($file->getFileUri())),
                  'filename' => $file->getFilename(),
                  'filemime' => $file->getMimeType(),
                ];

                // Add a secure download URL for the Twig template.
                $url = Url::fromUri(file_create_url($file->getFileUri()), ['absolute' => TRUE])->toString();
                $download_links[] = [
                  'title' => $variation->label(),
                  'url' => $url,
                ];
              }
            }
          }
        }
      }

      // Pass attachments to the mail backend.
      if (!empty($attachments)) {
        $message['params']['attachments'] = $attachments;
      }

      // Pass download links to Twig template.
      $message['params']['download_links'] = $download_links;
    }
  }
}
