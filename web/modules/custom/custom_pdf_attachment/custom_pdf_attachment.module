<?php


use Drupal\Core\Url;
use Drupal\commerce_order\Entity\OrderInterface;
use Drupal\commerce_file\Entity\FileLicense;

/**
 * Implements hook_mail_alter().
 */
function custom_pdf_attachment_mail_alter(&$message) {
   // Only alter the order receipt emails.
  if ($message['key'] === 'commerce_order_receipt') {

    /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
    $order = $message['params']['order'];

    if ($order instanceof OrderInterface) {
      $attachments = [];
      $download_links = [];

      // Loop through order items.
      foreach ($order->getItems() as $order_item) {

        // Load licenses for the order item.
        $licenses = \Drupal::entityTypeManager()
          ->getStorage('commerce_file_license')
          ->loadByProperties(['order_item_id' => $order_item->id()]);

        foreach ($licenses as $license) {

          if ($license instanceof FileLicense) {
            // Attach the file to the email.
            $file = $license->getFile();
            if ($file) {
              $file_path = \Drupal::service('file_system')->realpath($file->getFileUri());

              $attachments[] = [
                'filecontent' => file_get_contents($file_path),
                'filename' => $file->getFilename(),
                'filemime' => $file->getMimeType(),
              ];
            }

            // Create a secure download URL for the Twig template.
            $url = \Drupal\Core\Url::fromRoute(
              'entity.commerce_file_license.download',
              ['commerce_file_license' => $license->id()],
              ['absolute' => TRUE]
            )->toString();

            $download_links[] = [
              'title' => $order_item->label(),
              'url' => $url,
            ];
          }
        }
      }

      \Drupal::logger('custom_pdf_attachment')->notice('<pre>@links</pre>', ['@links' => print_r($download_links, TRUE)]);


      // Pass attachments to the mail backend.
      if (!empty($attachments)) {
        $message['params']['attachments'] = $attachments;
      }

      // Pass download links to Twig template.
      $message['params']['download_links'] = $download_links;
    }
  }
}

function custom_pdf_attachment_preprocess_commerce_order_receipt(&$variables) {
  $order = $variables['order_entity'];
  $download_links = [];

  foreach ($order->getItems() as $order_item) {
    $licenses = \Drupal::entityTypeManager()
      ->getStorage('commerce_file_license')
      ->loadByProperties(['order_item_id' => $order_item->id()]);

    foreach ($licenses as $license) {
      if ($license instanceof \Drupal\commerce_file\Entity\FileLicense) {
        $url = \Drupal\Core\Url::fromRoute(
          'entity.commerce_file_license.download',
          ['commerce_file_license' => $license->id()],
          ['absolute' => TRUE]
        )->toString();
        $download_links[] = [
          'title' => $order_item->label(),
          'url' => $url,
        ];
      }
    }
  }

  $variables['download_links'] = $download_links;
}