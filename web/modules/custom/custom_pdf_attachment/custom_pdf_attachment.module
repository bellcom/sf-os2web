<?php


use Drupal\Core\Url;
use Drupal\commerce_order\Entity\OrderInterface;

/**
 * Implements hook_mail_alter().
 */
function custom_pdf_attachment_mail_alter(&$message) {
  // Only alter the Commerce Order receipt email.
  if ($message['key'] === 'commerce_order_receipt') {
    if (!empty($message['params']['order']) && $message['params']['order'] instanceof OrderInterface) {
      $order = $message['params']['order'];
      $links = [];

      foreach ($order->getItems() as $order_item) {
        // Load licenses for this order item.
        $licenses = \Drupal::entityTypeManager()
          ->getStorage('commerce_file_license')
          ->loadByProperties(['order_item_id' => $order_item->id()]);

        foreach ($licenses as $license) {
          // Build a secure download URL for the license.
          $url = Url::fromRoute('entity.commerce_file_license.download', [
            'commerce_file_license' => $license->id(),
          ], ['absolute' => TRUE])->toString();

          $links[] = $url;
        }
      }

      if (!empty($links)) {
        // Append links to the email body.
        $message['body'][] = "\nYour download links:\n" . implode("\n", $links);
      }
    }
  }
}