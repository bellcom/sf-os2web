<?php

use Drupal\commerce_order\Entity\OrderInterface;
use Drupal\commerce_product\Entity\ProductVariationInterface;
use Drupal\file\Entity\File;

/**
 * Implements hook_commerce_order_receipt_mail_alter().
 */
function custom_pdf_attachment_commerce_order_receipt_mail_alter(array &$message, OrderInterface $order) {
  $attachments = [];
  $download_links = [];

  // Loop through order items.
  foreach ($order->getItems() as $order_item) {
    /** @var ProductVariationInterface $variation */
    $variation = $order_item->getPurchasedEntity();

    // Check for the correct file field on the product variation.
    if ($variation->hasField('commerce_file')) {
      foreach ($variation->get('commerce_file') as $field_item) {
        $file = $field_item->entity;
        if ($file instanceof File) {
          // Attach file content to email.
          $file_path = \Drupal::service('file_system')->realpath($file->getFileUri());
          $attachments[] = [
            'filecontent' => file_get_contents($file_path),
            'filename' => $file->getFilename(),
            'filemime' => $file->getMimeType(),
          ];

          // Add download link for Twig template.
          $download_links[] = [
            'title' => $file->getFilename(),
            'url' => file_create_url($file->getFileUri()),
          ];

          // Optional: log the file being attached for debugging.
          \Drupal::logger('custom_pdf_attachment')->notice('Adding file: @file', ['@file' => $file->getFilename()]);
        }
      }
    }
    else {
      // Optional: log if the variation doesn't have the file field.
      \Drupal::logger('custom_pdf_attachment')->warning('Variation @variation has no commerce_file field.', ['@variation' => $variation->id()]);
    }
  }

  // Attach files to email if found.
  if (!empty($attachments)) {
    $message['attachments'] = $attachments;
  }

  // Pass download links to Twig template.
  if (!empty($download_links)) {
    $message['download_links'] = $download_links;
  }
}
