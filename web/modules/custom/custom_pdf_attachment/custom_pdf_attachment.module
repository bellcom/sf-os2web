<?php

use Drupal\Core\Url;
use Drupal\commerce_order\Entity\OrderInterface;
use Drupal\file\Entity\File;
use Drupal\commerce_license\Entity\License;

/**
 * Implements hook_mail_alter().
 */
function custom_pdf_attachment_mail_alter(&$message) {
  // Only alter the order receipt emails.
  if ($message['key'] === 'commerce_order_receipt') {

    /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
    $order = $message['params']['order'];

    if ($order instanceof OrderInterface) {
      $attachments = [];
      $download_links = [];

      // Loop through order items.
      foreach ($order->getItems() as $order_item) {

        // Load licenses for this order item.
        $licenses = \Drupal::entityTypeManager()
          ->getStorage('commerce_license')
          ->loadByProperties(['originating_order' => $order->id()]);

        foreach ($licenses as $license) {
          if ($license instanceof License) {

            // Loop through files in the "licensed_files" field.
            foreach ($license->get('licensed_files') as $field_item) {
              $file = $field_item->entity;
              if ($file instanceof File) {
                // Attach the file.
                $file_path = \Drupal::service('file_system')->realpath($file->getFileUri());
                $attachments[] = [
                  'filecontent' => file_get_contents($file_path),
                  'filename' => $file->getFilename(),
                  'filemime' => $file->getMimeType(),
                ];

                // Add a download link for the template.
                $download_links[] = [
                  'title' => $file->getFilename(),
                  'url' => file_create_url($file->getFileUri()),
                ];
              }
            }
          }
        }
      }

      // Pass attachments to the mail backend.
      if (!empty($attachments)) {
        $message['params']['attachments'] = $attachments;
      }

      // Pass download links to Twig template.
      $message['params']['download_links'] = $download_links;
    }
  }
}

/**
 * Preprocess function for the commerce order receipt Twig template.
 */
function custom_pdf_attachment_preprocess_commerce_order_receipt(array &$variables) {
  if (!empty($variables['order_entity']) && !empty($variables['order_entity'] instanceof OrderInterface)) {
    if (!empty($variables['params']['download_links'])) {
      $variables['download_links'] = $variables['params']['download_links'];
    }
    else {
      $variables['download_links'] = [];
    }
  }
}
